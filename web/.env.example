# 복사해서 .env.local 로 사용 (커밋 금지)
# ── AI (OpenAI 호환 API 하나만 고르면 됨) ─────────────────────────
# [추천·무료] Google Gemini: https://aistudio.google.com 에서 키 발급
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# 모델명은 AI Studio에서 무료로 쓸 수 있는 Flash 계열 이름을 확인해서 입력
LLM_MODEL_EXTRACT=
LLM_MODEL_REASON=

# [무료 대안] Groq: https://console.groq.com — 구조화 출력 지원 모델 사용
# LLM_BASE_URL=https://api.groq.com/openai/v1
# [유료] OpenAI: LLM_BASE_URL 줄을 지우고 OpenAI 키·모델 입력

# ── 기타 ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 공공데이터포털 인증키 (잡알리오 채용정보, Q-net 시험일정)
DATA_GO_KR_SERVICE_KEY=
