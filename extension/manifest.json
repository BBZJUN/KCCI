{
  "manifest_version": 3,
  "name": "잡도리 — 캘린더에 담기",
  "version": "0.2.0",
  "description": "지금 보고 있는 채용 공고의 전형 일정을 잡도리 캘린더에 담습니다.",
  "action": { "default_popup": "popup.html", "default_title": "잡도리에 담기" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.vercel.app/*"],
  "optional_host_permissions": ["https://*/*"]
}
